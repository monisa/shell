{
  "name": "octa-multi-tenant",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run copy:mfe && ng serve",
    "build": "npm run copy:mfe && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "copy:mfe": "node scripts/copy-webcomponent-assets.js",
    "postinstall": "node scripts/copy-webcomponent-assets.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@piserve-tech/octa-form-builder-webcomponent": "^1.0.10",
    "@piserve-tech/octa-form-preview-webcomponent": "^1.0.9",
    "@piserve-tech/octa-form-submission-webcomponent": "^1.0.48",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
