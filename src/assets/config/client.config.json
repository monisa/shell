{
  "tenant": "client",
  "appName": "Client Experience Shell",
  "logoAlt": "Client Experience",
  "description": "Runtime-configured shell that hydrates branding and MFEs from JSON.",
  "configVersion": "2025.01.0",
  "layout": {
    "sidebar": "left",
    "sidebarWidth": "280px",
    "footerText": "Client Platform",
    "showNotifications": true
  },
  "defaultTheme": {
    "defaultMode": "light",
    "cacheVersion": "2025.01.0",
    "lightThemeUrl": "assets/themes/default_light.json",
    "darkThemeUrl": "assets/themes/default_dark.json",
    "fallbackLightThemeUrl": "assets/themes/fallback_light.json",
    "fallbackDarkThemeUrl": "assets/themes/fallback_dark.json"
  },
  "branding": {
    "primaryColor": "#2563EB",
    "secondaryColor": "#0EA5E9",
    "fontFamily": "'Inter', system-ui, sans-serif",
    "fontSize": "16px",
    "logoUrl": "assets/logos/octa-logo.svg"
  },
  "menu": [
    {
      "id": "dashboard",
      "label": "Dashboard",
      "route": "/",
      "icon": "dashboard"
    },
    {
      "id": "operations",
      "label": "Operations",
      "route": "/mfe/operations",
      "icon": "operations",
      "mfeId": "operations"
    },
    {
      "id": "reports",
      "label": "Reports",
      "route": "/mfe/reports",
      "icon": "reports",
      "mfeId": "reports"
    }
  ],
  "mfeRegistry": [
    {
      "id": "operations",
      "displayName": "Operations Console",
      "type": "web-component",
      "tagName": "client-operations-app"
    },
    {
      "id": "reports",
      "displayName": "Insights & Reports",
      "type": "web-component",
      "tagName": "client-reports-app"
    }
  ],
  "notifications": [
    {
      "id": "client-news",
      "level": "info",
      "message": "Client config loaded at runtime (client.config.json)."
    }
  ],
  "developer": {
    "fallbackTheme": "light",
    "dummyUser": {
      "name": "Client Admin",
      "title": "Workspace Owner"
    }
  }
}
